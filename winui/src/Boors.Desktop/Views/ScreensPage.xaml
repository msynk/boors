<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boors.Desktop.Views.ScreensPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Boors.Desktop.Infrastructure"
    xmlns:controls="using:Boors.Desktop.Controls"
    Background="Transparent">

    <Grid Padding="24,12,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:L K='Screens'}" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" HorizontalAlignment="Left" />
            <Button AutomationProperties.Name="{l:L K='CSV'}" Grid.Column="2" Click="OnExport">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                    <TextBlock Text="{l:L K='CSV'}" />
                </StackPanel>
            </Button>
        </Grid>
        <SelectorBar x:Name="Kinds" Grid.Row="1" SelectionChanged="OnKindChanged" />
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="WrapWholeWords" />
            <InfoBar Severity="Error" IsClosable="True" Title="{l:L K='Could not run the screen'}"
                     IsOpen="{x:Bind l:Bools.HasText(ViewModel.Error), Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        </StackPanel>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <controls:DataTable x:Name="Table" Items="{x:Bind ViewModel.Rows, Mode=OneWay}" />
        </Border>
        <TextBlock Grid.Row="4" Style="{StaticResource MutedTextStyle}"
                   Text="{l:L K='Screens rank equities by one factor using adjusted, point-in-time data. A rank is a starting point for research, not a buy or sell signal.'}" />
    </Grid>
</Page>
