<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boors.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Boors.Desktop.Infrastructure"
    Background="Transparent">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,12,24,24" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="{l:L K='Settings'}" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l:L K='Appearance'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="LanguageBox" Header="{l:L K='Language'}" MinWidth="320" SelectionChanged="OnLanguage" />
                    <ComboBox x:Name="ThemeBox" Header="{l:L K='Theme'}" MinWidth="320" SelectionChanged="OnTheme" />
                    <ComboBox x:Name="DigitsBox" Header="{l:L K='Digits'}" MinWidth="320" SelectionChanged="OnDigits" />
                    <StackPanel Spacing="6">
                        <ComboBox x:Name="PresetBox" Header="{l:L K='Up / down colours'}" MinWidth="320" SelectionChanged="OnPreset" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock x:Name="UpSample" FontWeight="SemiBold" />
                            <TextBlock x:Name="DownSample" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{l:L K='Every change also carries ▲ / ▼ and a sign, so colour is never the only cue.'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <ComboBox x:Name="DensityBox" Header="{l:L K='Density'}" MinWidth="320" SelectionChanged="OnDensity" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l:L K='Data source'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="ModeBox" Header="{l:L K='Read market data from'}" MinWidth="320" SelectionChanged="OnMode" />
                    <StackPanel x:Name="RemotePanel" Spacing="10">
                        <TextBox x:Name="NodeUrlBox" Header="{l:L K='Node URL'}" FlowDirection="LeftToRight" MinWidth="420" HorizontalAlignment="Left" LostFocus="OnNodeUrl" />
                        <PasswordBox x:Name="TokenBox" Header="{l:L K='Operator token (for running jobs on the node)'}" MinWidth="420" HorizontalAlignment="Left" LostFocus="OnToken" />
                    </StackPanel>
                    <ToggleSwitch x:Name="OfflineSwitch" OnContent="{l:L K='On'}" OffContent="{l:L K='Off'}" Header="{l:L K='Offline: never call a data source while reading (shareholders come from the store)'}" Toggled="OnOffline" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l:L K='Local store'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="{l:L K='Data folder (raw cache and market.duckdb)'}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DataRootBox" FlowDirection="LeftToRight" />
                            <Button Grid.Column="1" Content="{l:L K='Browse…'}" Click="OnBrowse" />
                            <Button Grid.Column="2" Content="{l:L K='Apply'}" Click="OnApplyDataRoot" />
                        </Grid>
                        <TextBlock x:Name="DataRootNote" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <TextBox x:Name="NodeNameBox" Header="{l:L K='Node name recorded on raw responses fetched here'}" FlowDirection="LeftToRight" MinWidth="320" HorizontalAlignment="Left" LostFocus="OnNodeName" />
                    <ToggleSwitch x:Name="CollectSwitch" OnContent="{l:L K='On'}" OffContent="{l:L K='Off'}" Header="{l:L K='Run the collection schedule in this app (Iran time)'}" Toggled="OnCollect" />
                    <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.RestartPending, Mode=OneWay}"
                             Title="{l:L K='Restart to apply'}" Message="{l:L K='The data folder, node name and schedule take effect after a restart.'}">
                        <InfoBar.ActionButton>
                            <Button Content="{l:L K='Restart now'}" Click="OnRestart" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{l:L K='About'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource MutedTextStyle}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
