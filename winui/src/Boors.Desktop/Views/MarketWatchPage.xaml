<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boors.Desktop.Views.MarketWatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Boors.Desktop.Infrastructure"
    xmlns:controls="using:Boors.Desktop.Controls"
    Background="Transparent">

    <Grid Padding="24,12,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title, groups, traded only, quick search, export -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:L K='Market watch'}" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
            <controls:Segmented x:Name="GroupSwitch" Grid.Column="1" VerticalAlignment="Center" />
            <CheckBox x:Name="TradedOnlyBox" Grid.Column="2" Content="{l:L K='Traded only'}" VerticalAlignment="Center"
                      IsChecked="{x:Bind ViewModel.TradedOnly, Mode=OneWay}" Click="OnTradedOnly" />
            <ProgressRing Grid.Column="3" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" HorizontalAlignment="Left" />
            <TextBox x:Name="QuickSearchBox" Grid.Column="4" Width="220" VerticalAlignment="Center"
                     PlaceholderText="{l:L K='Quick search in the grid'}" TextChanged="OnQuickSearch" />
            <Button AutomationProperties.Name="{l:L K='CSV'}" Grid.Column="5" Click="OnExport" ToolTipService.ToolTip="{l:L K='Export the grid as CSV (UTF-8, ASCII numbers)'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                    <TextBlock Text="{l:L K='CSV'}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- TSETMC filter -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="FilterBox" Header="{l:L K='TSETMC filter'}" FlowDirection="LeftToRight" AcceptsReturn="False"
                         FontFamily="{StaticResource MonoFontFamily}" IsSpellCheckEnabled="False" TextWrapping="Wrap" MaxHeight="96"
                         PlaceholderText="(pc)>(py)*1.03 &amp;&amp; (ct).Buy_I_Volume>(ct).Sell_I_Volume"
                         Text="{x:Bind ViewModel.Filter, Mode=OneWay}" KeyDown="OnFilterKeyDown" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button AutomationProperties.Name="{l:L K='Apply'}" Style="{StaticResource AccentButtonStyle}" Click="OnApply">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71C;" FontSize="14" />
                            <TextBlock Text="{l:L K='Apply'}" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnClear" Content="{l:L K='Clear'}" />
                    <DropDownButton x:Name="PresetsButton" Content="{l:L K='Example filters'}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource MutedTextStyle}"
                           Text="{l:L K='Same syntax as the TSETMC market-watch filters, including [ih] history and the true==function(){...}() code mode. Enter applies.'}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar Severity="Error" IsClosable="True" Title="{l:L K='Filter error'}"
                     IsOpen="{x:Bind l:Bools.HasText(ViewModel.FilterError), Mode=OneWay}" Message="{x:Bind ViewModel.FilterError, Mode=OneWay}" />
            <InfoBar Severity="Error" IsClosable="True" Title="{l:L K='Could not load the market watch'}"
                     IsOpen="{x:Bind l:Bools.HasText(ViewModel.Error), Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
            <InfoBar x:Name="FilterErrorsBar" Severity="Warning" IsClosable="True"
                     Title="{l:L K='Some instruments were skipped because the filter failed on them'}"
                     IsOpen="{x:Bind l:Bools.AnyText(ViewModel.FilterErrors), Mode=OneWay}">
                <InfoBar.Content>
                    <ScrollViewer MaxHeight="120" Margin="0,0,0,12">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilterErrors, Mode=OneWay}" FlowDirection="LeftToRight" />
                    </ScrollViewer>
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <controls:DataTable x:Name="Table" Items="{x:Bind ViewModel.Rows, Mode=OneWay}" FrozenColumns="1" />
        </Border>

        <!-- Footer: session, counts, timings -->
        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            <TextBlock Grid.Column="1" Style="{StaticResource MutedTextStyle}" Text="{l:L K='Click a header to sort, a row to open the symbol. Queue tags show the value waiting at the band (billion toman).'}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="TimingText" Grid.Column="2" Style="{StaticResource MutedTextStyle}" />
        </Grid>
    </Grid>
</Page>
