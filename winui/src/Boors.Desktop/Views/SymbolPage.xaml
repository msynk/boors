<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boors.Desktop.Views.SymbolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Boors.Desktop.Infrastructure"
    xmlns:vm="using:Boors.Desktop.ViewModels"
    xmlns:controls="using:Boors.Desktop.Controls"
    xmlns:charts="using:Boors.Desktop.Charts"
    Background="Transparent">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,12,24,24" Spacing="16">
            <InfoBar Severity="Error" IsClosable="True" Title="{l:L K='Could not load this instrument'}"
                     IsOpen="{x:Bind l:Bools.HasText(ViewModel.Error), Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
            <InfoBar Severity="Warning" IsClosable="False" Title="{l:L K='This instrument is not in the store.'}"
                     IsOpen="{x:Bind ViewModel.NotFound, Mode=OneWay}" />

            <!-- Header: symbol, name, class, sector; price and change -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NameText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="18" Height="18" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2"
                                Visibility="{x:Bind vm:Ui.ShowText(ViewModel.ClassText), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ClassText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                        <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,1"
                                Visibility="{x:Bind vm:Ui.ShowText(ViewModel.SectorText), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.SectorText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.Price, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" Style="{StaticResource NumberTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ChangeText, Mode=OneWay}" FontSize="18" VerticalAlignment="Center"
                                   Foreground="{x:Bind l:Palette.ToneBrush(ViewModel.ChangeTone), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.AsOfText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Grid>

            <!-- Returns and key metrics -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Kpis, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="190" MinItemHeight="80" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:KpiItem">
                        <controls:KpiTile Item="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- 52-week range and buyer power with its percentile -->
            <Grid ColumnSpacing="10" x:Name="RangeRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:L K='52-week range (adjusted)'}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <controls:RangeBar Fraction="{x:Bind ViewModel.RangeFraction, Mode=OneWay}" StartText="{x:Bind ViewModel.RangeLow, Mode=OneWay}" EndText="{x:Bind ViewModel.RangeHigh, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.RangeNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TileStyle}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{l:L K='Buyer power'}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.BuyerPowerText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{l:L K='· percentile vs. its own year'}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <controls:RangeBar x:Name="PowerBar" Fraction="{x:Bind ViewModel.PowerFraction, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.PowerNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Price, value and flow panes on one shared session axis -->
            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:Segmented x:Name="RangeSwitch" Compact="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"
                                   Text="{l:L K='Drag to pan, wheel to zoom; the three panes share the axis.'}" />
                        <ToggleSwitch x:Name="AdjustedSwitch" Grid.Column="2" OnContent="{l:L K='Adjusted for capital increases and dividends'}"
                                      OffContent="{l:L K='Raw prices'}" Toggled="OnAdjustedToggled" />
                    </Grid>
                    <charts:SymbolChart x:Name="Chart" Grid.Row="1" Height="560" />
                </Grid>
            </Border>

            <!-- Events, shareholders, Codal letters, supervisor messages -->
            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                        <SelectorBarItem x:Name="EventsTab" Tag="events" IsSelected="True" />
                        <SelectorBarItem x:Name="HoldersTab" Tag="holders" />
                        <SelectorBarItem x:Name="LettersTab" Tag="letters" />
                        <SelectorBarItem x:Name="MessagesTab" Tag="messages" />
                    </SelectorBar>
                    <Grid Grid.Row="1" MinHeight="200">
                        <controls:DataTable x:Name="EventsTable" Height="360" Items="{x:Bind ViewModel.Events, Mode=OneWay}" />
                        <Grid x:Name="HoldersPanel" Visibility="Collapsed" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.HoldersLoading, Mode=OneWay}" />
                            <controls:DataTable x:Name="HoldersTable" Grid.Row="1" Height="360" Items="{x:Bind ViewModel.Shareholders, Mode=OneWay}" />
                        </Grid>
                        <ItemsRepeater x:Name="LettersList" Visibility="Collapsed" ItemsSource="{x:Bind ViewModel.Letters, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FeedItem">
                                    <StackPanel Padding="0,2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <HyperlinkButton Content="{x:Bind Title}" NavigateUri="{x:Bind Link}" Padding="0,2" Visibility="{x:Bind LinkVisibility}" />
                                            <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind TextTitleVisibility}" TextWrapping="WrapWholeWords" TextAlignment="DetectFromContent" />
                                            <HyperlinkButton Content="Excel" NavigateUri="{x:Bind ExcelLink}" Padding="0,2" Visibility="{x:Bind ExcelVisibility}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <ItemsRepeater x:Name="MessagesList" Visibility="Collapsed" ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FeedItem">
                                    <StackPanel Padding="0,2,0,6" Spacing="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="WrapWholeWords" TextAlignment="DetectFromContent" />
                                        <TextBlock Text="{x:Bind Body}" TextWrapping="WrapWholeWords" Visibility="{x:Bind BodyVisibility}" TextAlignment="DetectFromContent" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock x:Name="FeedEmpty" Visibility="Collapsed" Style="{StaticResource MutedTextStyle}" Margin="0,16" />
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
