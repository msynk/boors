<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Boors.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Vazirmatn (variable, OFL) for all UI text, Persian and Latin. Bundled; never loaded from a CDN. -->
            <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/Vazirmatn-Variable.ttf#Vazirmatn</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Vazirmatn-Variable.ttf#Vazirmatn</FontFamily>
            <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>
            <x:Double x:Key="KpiValueFontSize">20</x:Double>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style x:Key="TileStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="MinHeight" Value="92" />
            </Style>

            <Style x:Key="NumberTextStyle" TargetType="TextBlock">
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
