<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Boors.Desktop.Controls.KpiTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Boors.Desktop.Controls"
    xmlns:infra="using:Boors.Desktop.Infrastructure">

    <!-- A headline number: caption, value, signed change with arrow, note and sparkline (stat tile, never a one-bar chart). -->
    <Border Style="{StaticResource TileStyle}" ToolTipService.ToolTip="{x:Bind Item.Caption, Mode=OneWay}">
        <Grid RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind Item.Caption, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Height="30">
                    <TextBlock Text="{x:Bind Item.Value, Mode=OneWay}" FontSize="{StaticResource KpiValueFontSize}" FontWeight="SemiBold"
                               Foreground="{x:Bind infra:Palette.ValueBrush(Item.ValueTone), Mode=OneWay}"
                               Style="{StaticResource NumberTextStyle}" />
                </Viewbox>
                <controls:Sparkline Grid.Column="1" Width="64" Height="26" VerticalAlignment="Center"
                                    Values="{x:Bind Item.Spark, Mode=OneWay}" Visibility="{x:Bind Item.SparkVisibility, Mode=OneWay}" />
            </Grid>
            <TextBlock Grid.Row="2" Text="{x:Bind Item.Change, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{x:Bind infra:Palette.ToneBrush(Item.ChangeTone), Mode=OneWay}" Visibility="{x:Bind Item.ChangeVisibility, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock Grid.Row="3" Text="{x:Bind Item.Note, Mode=OneWay}" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind Item.NoteVisibility, Mode=OneWay}"
                       TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" MaxLines="2" />
        </Grid>
    </Border>
</UserControl>
