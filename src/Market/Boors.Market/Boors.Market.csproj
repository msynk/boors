<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Boors.Market</RootNamespace>
        <Description>Iranian capital-market data: TSETMC/Codal clients, raw response cache, parsers, dated market rules and day-status classification.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="DNTPersianUtils.Core" />
        <PackageReference Include="YamlDotNet" />
        <PackageReference Include="DuckDB.NET.Data.Full" />
        <PackageReference Include="Jint" />
    </ItemGroup>

    <ItemGroup>
        <!-- The dated rules live at the repository root so they are reviewed like code; ship a copy inside the assembly as the default. -->
        <EmbeddedResource Include="..\..\..\rules\rules.yaml" LogicalName="Boors.Market.rules.yaml" Link="Rules\rules.yaml" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Boors.Market.Tests" />
    </ItemGroup>

</Project>
