    "eslint": "10.13.0",
    "eslint-plugin-solid": "0.18.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5"
